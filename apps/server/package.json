{
  "name": "@toonflow/server",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:migrate": "bun src/db/runMigrations.ts",
    "test": "bun test ./src",
    "build": "bun build src/index.ts --target=bun --minify --outdir ../../build/server",
    "start": "bun ../../build/server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.12",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2"
  }
}
